# Mọi biến môi trường mà code trong repo này đọc. tests/test_build.js kiểm danh sách này
# khớp với code; thêm biến mới thì phải thêm vào đây, kèm giải thích.
# Không biến nào là bí mật. Trang chạy được mà không cần đặt biến nào.

# Commit đang build. GitHub Actions tự đặt. Chạy trên máy thì để trống: build.js tự hỏi git.
GITHUB_SHA=
# Nhánh đang build. GitHub Actions tự đặt. Chạy trên máy thì để trống: build.js tự hỏi git.
GITHUB_REF_NAME=

# Chỉ tests/e2e.js đọc. Địa chỉ bản đã đưa lên để kiểm; để trống thì kiểm dist/index.html trên máy.
E2E_URL=
# Chỉ tests/e2e.js đọc. Commit mong đợi trên bản đã đưa lên; đặt khi kiểm sau deploy.
EXPECT_COMMIT=

# Commit đang build. Cloudflare Pages tự đặt. build.js dùng khi không có GITHUB_SHA.
CF_PAGES_COMMIT_SHA=
# Nhánh đang build. Cloudflare Pages tự đặt. build.js dùng khi không có GITHUB_REF_NAME.
CF_PAGES_BRANCH=

# Chỉ tests/e2e.js đọc. Trình duyệt có sẵn trên máy để chạy e2e thay cho Chromium của Playwright:
# msedge (Edge, có sẵn trên Windows) hoặc chrome. Để trống thì dùng Chromium tải bằng `npx playwright install chromium`.
E2E_CHANNEL=

# Commit đang build. Cloudflare Workers Builds tự đặt. build.js dùng khi không có GITHUB_SHA, CF_PAGES_COMMIT_SHA.
WORKERS_CI_COMMIT_SHA=
# Nhánh đang build. Cloudflare Workers Builds tự đặt.
WORKERS_CI_BRANCH=
